# Backend (copy to backend/.env)
DATABASE_URL=sqlite:///./property2claim.db
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
JEV_API_KEY=
JEV_API_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
NASA_FIRMS_MAP_KEY=
NOAA_USER_AGENT=Property2Claim/1.0 (contact: demo@example.invalid)
ALLOW_LIVE_HAZARDS=false
DEMO_MODE=true

# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# CesiumJS uses attributed Esri World Imagery with a token-free NASA GIBS fallback.
